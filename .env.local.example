# ── F1 GUIDE · 环境变量模板 ────────────────────────
# 复制本文件为 .env.local，填入真实值后启动开发服务器
# .env.local 已在 .gitignore 中排除，不会提交到 Git

# ── Supabase ─────────────────────────────────────
# 在 Supabase Dashboard → Settings → API 中获取
VITE_SUPABASE_URL=https://你的项目ID.supabase.co
VITE_SUPABASE_ANON_KEY=你的anon_public_key

# ── Jolpica F1 API（无需 Key，公开接口） ──────────
# 文档：https://jolpi.ca/
VITE_JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
